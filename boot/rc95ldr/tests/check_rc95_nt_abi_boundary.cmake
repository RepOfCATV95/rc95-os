if(NOT DEFINED RC95LDR_SOURCE_DIR)
    message(FATAL_ERROR "RC95LDR_SOURCE_DIR is required")
endif()
set(_winload "${RC95LDR_SOURCE_DIR}/winload")
file(READ "${_winload}/include/rc95ldrrc95loaderstate.h" _rc95_state_h)
file(READ "${_winload}/rc95loaderstate.c" _rc95_state_c)
file(READ "${_winload}/include/rc95ldrloaderblock.h" _loaderblock_h)
file(READ "${_winload}/loaderblock.c" _loaderblock_c)
file(READ "${_winload}/include/rc95ldrloaderblock.h" _loaderblock_h)
string(FIND "${_loaderblock_c}" "static void InitRc95List" _rc95_impl)
string(FIND "${_loaderblock_c}" "RC95LDR_STATUS Rc95LdrBuildNtLegacyLoaderBlock" _nt_impl)
if(_rc95_impl LESS 0 OR _nt_impl LESS 0 OR _nt_impl LESS _rc95_impl)
    message(FATAL_ERROR "Could not isolate RC95 loader-block implementation")
endif()
math(EXPR _rc95_impl_length "${_nt_impl} - ${_rc95_impl}")
string(SUBSTRING "${_loaderblock_c}" ${_rc95_impl} ${_rc95_impl_length} _rc95_impl_text)
if(_rc95_impl_text MATCHES "RC95LDR_NT_|NtBootPath|ArcBootDevice|ArcHalDevice")
    message(FATAL_ERROR "RC95 loader builder still consumes NT loader input fields or types")
endif()
string(FIND "${_loaderblock_h}" "typedef struct _RC95LDR_RC95_LOADER_INPUT" _rc95_input)
string(FIND "${_loaderblock_h}" "RC95LDR_STATUS Rc95LdrBuildNtLegacyLoaderBlock" _nt_input_end)
if(_rc95_input LESS 0 OR _nt_input_end LESS _rc95_input)
    message(FATAL_ERROR "RC95-specific loader input ABI is missing")
endif()
math(EXPR _rc95_input_length "${_nt_input_end} - ${_rc95_input}")
string(SUBSTRING "${_loaderblock_h}" ${_rc95_input} ${_rc95_input_length} _rc95_input_text)
if(_rc95_input_text MATCHES "RC95LDR_NT_|NtVersion|ArchitectureBlock")
    message(FATAL_ERROR "RC95 loader input imports NT ABI fields")
endif()
file(READ "${_winload}/nativeprepare.c" _nativeprepare)
file(READ "${_winload}/archprepare.c" _archprepare)
file(READ "${_winload}/handoff.c" _handoff)
if(_rc95_state_h MATCHES "rc95ldrloaderstate.h|rc95ldrntabi.h|RC95LDR_NT_")
    message(FATAL_ERROR "RC95 loader-state contract imports NT ABI definitions")
endif()
if(_rc95_state_c MATCHES "RC95LDR_NT_|Rc95LdrBuildNtLoaderState")
    message(FATAL_ERROR "RC95 loader-state implementation references NT loader state")
endif()
string(FIND "${_loaderblock_h}" "typedef struct _RC95LDR_RC95_NATIVE_LOADER_BLOCK" _rc95_block)
if(_rc95_block LESS 0)
    message(FATAL_ERROR "RC95-native loader block definition is missing")
endif()
string(SUBSTRING "${_loaderblock_h}" ${_rc95_block} -1 _rc95_block_tail)
string(FIND "${_rc95_block_tail}" "RC95LDR_STATUS Rc95LdrBuildNtLegacyLoaderBlock" _rc95_block_end)
if(_rc95_block_end LESS 0)
    message(FATAL_ERROR "Could not delimit RC95 loader-block definition")
endif()
string(SUBSTRING "${_rc95_block_tail}" 0 ${_rc95_block_end} _rc95_block_text)
if(_rc95_block_text MATCHES "RC95LDR_NT_")
    message(FATAL_ERROR "RC95 loader-block layout uses NT ABI types")
endif()
string(FIND "${_nativeprepare}" "input.NlsData=metadata.NlsData" _prepare_state_start)
if(_prepare_state_start LESS 0)
    message(FATAL_ERROR "Could not locate profile loader-state selection")
endif()
string(SUBSTRING "${_nativeprepare}" ${_prepare_state_start} -1 _prepare_state_tail)
string(FIND "${_prepare_state_tail}" "if (request->Profile->OsFamily == Rc95LdrOsRc95)" _rc95_state_branch)
string(FIND "${_prepare_state_tail}" "else if (request->Profile->OsFamily == Rc95LdrOsWindowsNtLegacy" _nt_state_branch)
if(_rc95_state_branch LESS 0 OR _nt_state_branch LESS 0 OR _nt_state_branch LESS _rc95_state_branch)
    message(FATAL_ERROR "Could not isolate RC95 and NT loader-state branches")
endif()
math(EXPR _rc95_state_length "${_nt_state_branch} - ${_rc95_state_branch}")
string(SUBSTRING "${_prepare_state_tail}" ${_rc95_state_branch} ${_rc95_state_length} _rc95_state_branch_text)
if(_rc95_state_branch_text MATCHES "Rc95LdrBuildNtLoaderState|request->LoaderStateInput")
    message(FATAL_ERROR "RC95 preparation still consumes NT loader-state input or builder")
endif()
foreach(_required IN ITEMS "Rc95LoaderStateInput" "Rc95LdrBuildRc95LoaderState" "Rc95LdrBuildNtLoaderState")
    if(NOT _nativeprepare MATCHES "${_required}")
        message(FATAL_ERROR "Native preparation is missing profile provider ${_required}")
    endif()
endforeach()
foreach(_required IN ITEMS "ProcessorControl.Rc95I386" "ProcessorControl.Rc95Amd64")
    if(NOT _archprepare MATCHES "${_required}" AND NOT _handoff MATCHES "${_required}")
        message(FATAL_ERROR "RC95 processor-state contract missing ${_required}")
    endif()
endforeach()
